{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Video Sub",
  "version": "0.1.0",
  "identifier": "com.caravaggio.videosub",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Sottotitoli — Caravaggio",
        "width": 1440,
        "height": 900,
        "minWidth": 1100,
        "minHeight": 720
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "resources": [
      "../worker/transcribe.py",
      "../worker/export_source.py",
      "../worker/export_output.py",
      "../worker/translate.py",
      "../worker/subtitles.py",
      "../worker/requirements.txt"
    ]
  }
}
